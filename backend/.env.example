# Troque por uma string longa e aleatória em produção
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio

# Dias até o token expirar
TOKEN_EXPIRE_DAYS=30

# Caminho do banco SQLite
DB_PATH=motoristas.db

# Origens permitidas (separadas por vírgula). Use * só em dev local.
# Em produção, coloque o domínio do app: https://seuapp.com
CORS_ORIGINS=*
